{
  "openapi": "3.0.3",
  "info": {
    "title": "Validador de Ações Judiciais API",
    "version": "0.1.0",
    "description": "Contrato atual do frontend e do mock da API para gestão de solicitações judiciais."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/requests": {
      "get": {
        "summary": "Lista solicitações do usuário autenticado",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "SUBMITTED",
                "PROCESSING",
                "APPROVED",
                "REJECTED",
                "ERROR",
                "NEEDS_CORRECTION",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "debtorCnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de solicitações",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedRequestsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/requests/drafts": {
      "post": {
        "summary": "Cria um rascunho de solicitação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChecklistPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rascunho criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCreated"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/requests/submit": {
      "post": {
        "summary": "Submete uma solicitação com arquivos",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["metadata", "files"],
                "properties": {
                  "metadata": {
                    "type": "string",
                    "description": "JSON serializado do payload da solicitação atual."
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Solicitação aceita para processamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}": {
      "get": {
        "summary": "Detalha uma solicitação",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhe da solicitação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Atualiza uma solicitação existente",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["metadata", "files"],
                "properties": {
                  "metadata": {
                    "type": "string",
                    "description": "JSON serializado do payload da solicitação atual."
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitação atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestUpdated"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}/documents": {
      "post": {
        "summary": "Envia arquivos anexos para uma solicitação",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["requestId", "userId", "files"],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Documentos enviados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "summary": "Remove documentos da solicitação",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequestDocumentsPayload"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Documentos removidos"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}/export/pdf": {
      "get": {
        "summary": "Exporta a solicitação em PDF",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}/export/csv": {
      "get": {
        "summary": "Exporta a solicitação em CSV",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo CSV",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}/export/xlsx": {
      "get": {
        "summary": "Exporta a solicitação em Excel",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo Excel",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/requests/{requestId}/documents/{documentId}/download": {
      "get": {
        "summary": "Baixa um documento da solicitação",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo do documento",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/requests/approved": {
      "get": {
        "summary": "Lista solicitações aprovadas para DEJUR/ADMIN",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "debtorCnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitações aprovadas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedRequestsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "Lista notificações",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NotificationItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Não autenticado ou token inválido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "RequestStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "PROCESSING",
          "APPROVED",
          "REJECTED",
          "ERROR",
          "NEEDS_CORRECTION",
          "CANCELLED"
        ]
      },
      "ChecklistType": {
        "type": "string",
        "enum": [
          "RECUPERACAO_VASILHAMES",
          "COBRANCA_TITULOS",
          "COBRANCA_MULTA_CONTRATUAL"
        ]
      },
      "RequestListItem": {
        "type": "object",
        "required": [
          "requestId",
          "checklistType",
          "debtorName",
          "debtorCnpj",
          "status",
          "createdAt",
          "updatedAt",
          "createdByEmail"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "example": "REQ-2026-07-03-000001"
          },
          "checklistType": {
            "$ref": "#/components/schemas/ChecklistType"
          },
          "debtorName": {
            "type": "string",
            "example": "Distribuidora Exemplo LTDA"
          },
          "debtorCnpj": {
            "type": "string",
            "example": "17409361000199"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-30T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-30T00:00:00.000Z"
          },
          "createdByEmail": {
            "type": "string",
            "format": "email",
            "example": "maria.silva@empresa.com"
          },
          "llmScore": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "example": 0.94
          }
        }
      },
      "PaginatedRequestsResponse": {
        "type": "object",
        "required": ["items", "totalCount"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestListItem"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "NotificationItem": {
        "type": "object",
        "required": ["id", "title", "read"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RequestCreated": {
        "type": "object",
        "required": ["requestId", "status"],
        "properties": {
          "requestId": {
            "type": "string",
            "example": "REQ-2026-07-03-000122"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["requestId", "status", "queuePosition"],
        "properties": {
          "requestId": {
            "type": "string",
            "example": "REQ-2026-07-03-000123"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "queuePosition": {
            "type": "integer",
            "format": "int32",
            "example": 2
          }
        }
      },
      "RequestUpdated": {
        "type": "object",
        "required": ["requestId", "status", "updatedAt"],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatedBy": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Maria Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "maria.silva@empresa.com"
          }
        }
      },
      "RequestCompany": {
        "type": "object",
        "required": ["name", "cnpj", "uf", "city"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Empresa Credora SA"
          },
          "cnpj": {
            "type": "string",
            "example": "24265750000153"
          },
          "uf": {
            "type": "string",
            "example": "SP"
          },
          "city": {
            "type": "string",
            "example": "Sao Paulo"
          }
        }
      },
      "RequestDebtor": {
        "type": "object",
        "required": [
          "name",
          "cnpj",
          "uf",
          "city",
          "debtorAddress",
          "addressConfirmedBy",
          "addressConfirmedByRole",
          "addressConfirmedByDate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Distribuidora Exemplo LTDA"
          },
          "cnpj": {
            "type": "string",
            "example": "17409361000199"
          },
          "uf": {
            "type": "string",
            "example": "RJ"
          },
          "city": {
            "type": "string",
            "example": "Rio de Janeiro"
          },
          "debtorAddress": {
            "type": "string",
            "example": "debtorAddress - XxX"
          },
          "addressConfirmedBy": {
            "type": "string",
            "example": "addressConfirmedBy - XyZ"
          },
          "addressConfirmedByRole": {
            "type": "string",
            "example": "Analista Jurídico"
          },
          "addressConfirmedByDate": {
            "type": "string",
            "format": "date",
            "example": "2026-07-03"
          }
        }
      },
      "RequestFinancial": {
        "type": "object",
        "required": ["amount", "currency", "dueDate"],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "example": 152340.55
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-30"
          },
          "index": {
            "type": "string",
            "example": "IPCA"
          }
        }
      },
      "AgreementAttempt": {
        "type": "object",
        "required": ["date", "channel", "result"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-06-15"
          },
          "channel": {
            "type": "string",
            "example": "email"
          },
          "result": {
            "type": "string",
            "example": "sem resposta"
          }
        }
      },
      "RequestOpinion": {
        "type": "object",
        "required": ["recommendedAction"],
        "properties": {
          "recommendedAction": {
            "type": "string",
            "example": "Ajuizamento"
          },
          "details": {
            "type": "string",
            "example": "Ação recomendada com base na análise do contrato."
          }
        }
      },
      "RequestDocument": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "example": "doc_123"
          },
          "name": {
            "type": "string",
            "example": "contrato.pdf"
          },
          "type": {
            "type": "string",
            "example": "CONTRATO"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ClientValidation": {
        "type": "object",
        "required": ["approvedByClient"],
        "properties": {
          "approvedByClient": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "required": ["at", "from", "to"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-03T14:20:00Z"
          },
          "from": {
            "type": "string",
            "example": "DRAFT"
          },
          "to": {
            "type": "string",
