{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: servidor",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: navegador",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack:///*": "${webRoot}/*",
        "turbopack:///*": "${webRoot}/*"
      }
    },
    {
      "name": "Vitest: watch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:watch"
    },
    {
      "name": "Playwright: e2e",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:e2e"
    },
    {
      "name": "Mock API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run mock:api"
    }
  ],
  "compounds": [
    {
      "name": "🚀👩‍🚀👨‍🚀 - dev debug full stack",
      "configurations": ["Next.js: servidor", "Next.js: navegador"],
      "stopAll": true
    }
  ]
}
